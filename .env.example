# Autergo Recruitment Platform — Environment & Secrets Configuration Template
# Copy this file to .env and populate values for local deployment.
# For CI/CD and production environments, configure these variables in GitHub Secrets / Cloud Secret Manager.

# -----------------------------------------------------------------------------
# 1. CORE APPLICATION & SECURITY
# -----------------------------------------------------------------------------
PROJECT_NAME="Autergo Recruitment Platform"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-32-character-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL + pgvector)
# -----------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=autergo
POSTGRES_PASSWORD=autergo_password
POSTGRES_DB=autergo_db

# -----------------------------------------------------------------------------
# 3. CACHE & MESSAGE BROKER (Redis 7)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# -----------------------------------------------------------------------------
# 4. STORAGE / PROCTORING EVIDENCE (S3 / MinIO)
# -----------------------------------------------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=autergo-evidence
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# 5. MULTI-TIER LLM & AI PROVIDERS
# -----------------------------------------------------------------------------
# Primary Provider: NVIDIA Cloud API (Nemotron 3.5 Lightning with Reasoning Tokens)
NVIDIA_API_KEY=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
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_PRIMARY_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Secondary / Fallback Provider: Groq Cloud API (Free Tier High Speed Models)
GROQ_API_KEY=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
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=gemma2-9b-it

# -----------------------------------------------------------------------------
# 6. FRONTEND NEXT.JS PUBLIC CONFIGURATION
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws
